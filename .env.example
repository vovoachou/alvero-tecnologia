# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Resend API Key for sending diagnostic lead emails
RESEND_API_KEY="re_123456789"

# Meta Pixel (ID do conjunto de dados no Gerenciador de Eventos).
# Sem valor, o Pixel não é carregado. Só é ativado após o aceite no banner de cookies.
NEXT_PUBLIC_META_PIXEL_ID=""

# Opcional: código da meta tag de verificação de domínio do Meta Business
# (somente o valor de content="..."). Alternativa: registro TXT no DNS.
META_DOMAIN_VERIFICATION=""
